# 信任流程（git 源，覆盖 M3 验收 ② 与 §10.5 两分句）：
#  首次遇到 → 全文 + 退出码 4；--yes 记录确认；
#  内容变化 → 「相对已记录版本」的行级 diff + 退出码 4；
#  --no-hooks → 记录已见但不执行、下次仍要确认；
#  确认后同内容重跑 → 不再询问。
# 注：第 18 步钩子「执行」已接线（T6）——--yes 轮除信任记录外还断言钩子
# 产物；失败与副作用的完整覆盖见 hooks_fail / sideeffects 脚本。

env HOME=$WORK/home
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
mkdir tpl
cp $WORK/base.yml tpl/xinit.yml
cp $WORK/a1.txt tpl/a.txt
exec git init -q tpl
cd tpl
exec git add .
exec git commit -qm v1
exec git tag v0.1.0
cd ..

xinit init --template $WORK/tpl --yes out
cd out
cp .xinit/state.json $WORK/state0.json

# 模板 v2：新增 post_update（钩子首次出现）→ 退出码 4、通知含全文
cp $WORK/hooks-a.yml $WORK/tpl/xinit.yml
# a2 变更让 `! exists .xinit/backup` 成为真判别器（评审 Minor-1 复修）
cp $WORK/a2.txt $WORK/tpl/a.txt
cd ../tpl
exec git add .
exec git commit -qm v2
exec git tag v0.2.0
cd ../out
xinit-code update --revision v0.2.0
stdout '模板钩子 post_update 需要确认'
stdout 'echo A > out_a.txt'
stdout 'exit=4'
! exists out_a.txt
# exit-4 零写（§10.2 第 6 步先于备份；评审 Minor-1）与输出形态（Minor-2/3）
! exists .xinit/backup
cmp .xinit/state.json $WORK/state0.json
! stdout '相对已记录版本'
! stdout 'xinit update:'
# 内容维度零写：a.txt 未被应用（评审 Minor-1 复修）
cmp a.txt $WORK/a1.txt

# --yes：确认并记录 {hashA: v0.2.0}
xinit-code update --revision v0.2.0 --yes
stdout 'exit=0'
# 该轮真实应用变更（评审 Minor-1 复修：证明 a2 变更非空且被写入）
cmp a.txt $WORK/a2.txt
# «已确认» 的持久化证据：trusted_hooks[hashA] = "v0.2.0"（非空版本值，非 marker）
grep '"sha256:[0-9a-f]{64}": "v0.2.0"' .xinit/state.json
# 第 18 步确实执行了钩子 A（S-9 恢复）：产物内容与 want-a.txt 一致
cmp out_a.txt $WORK/want-a.txt
# --yes 预先确认不打指引尾注（T4-R2 的 update 侧护栏；评审 Minor-2）
! stdout '在原命令后加 --yes'

# 模板 v3：钩子内容变为 B → 相对 v0.2.0 的 diff 出现，退出码 4
cp $WORK/hooks-b.yml $WORK/tpl/xinit.yml
cd ../tpl
exec git add .
exec git commit -qm v3
exec git tag v0.3.0
cd ../out
xinit-code update --revision v0.3.0
stdout '相对已记录版本 v0.2.0 的差异'
stdout '- echo A > out_a.txt'
stdout '\+ echo B > out_b.txt'
stdout 'exit=4'

# --no-hooks：只记录已见（marker），不执行
xinit-code update --revision v0.3.0 --no-hooks
stdout 'exit=0'
! exists out_b.txt

# marker 之后：不带 --no-hooks 重跑仍要确认（§10.5 第二分句）
xinit-code update --revision v0.3.0
stdout '模板钩子 post_update 需要确认'
stdout 'exit=4'

# --yes 确认 → 记录 {hashB: v0.3.0}；随后同内容重跑不再询问
xinit-code update --revision v0.3.0 --yes
stdout 'exit=0'
grep '"sha256:[0-9a-f]{64}": "v0.3.0"' .xinit/state.json
# 第 18 步确实执行了钩子 B（S-9 恢复）
exists out_b.txt
xinit-code update --revision v0.3.0
stdout 'exit=0'
! stdout '需要确认'

# M3-R1「已有值不动」：对已确认 hash 再走 --no-hooks 不得降级为 marker（评审 Nit-1）
xinit-code update --revision v0.3.0 --no-hooks
stdout 'exit=0'
xinit-code update --revision v0.3.0
stdout 'exit=0'
! stdout '需要确认'
# 末尾重跑仍执行钩子 B（S-9 恢复；与上面 --no-hooks 轮的 ! exists 互为护栏）
exists out_b.txt

-- base.yml --
manifest_version: 1

-- a1.txt --
hello

-- hooks-a.yml --
manifest_version: 1
hooks:
  post_update: |
    echo A > out_a.txt

-- hooks-b.yml --
manifest_version: 1
hooks:
  post_update: |
    echo B > out_b.txt

-- want-a.txt --
A
-- a2.txt --
hello2
