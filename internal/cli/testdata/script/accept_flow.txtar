# --accept 全流程（§10.3）：手工解决后直接重跑 = 死循环（再次被拒）；
# --accept 把「你看到并认可的版本」记为 base → 收敛；五个拒绝项（A–E）。

xinit init --template $WORK/tpl --yes out
cp $WORK/new-a.txt $WORK/tpl/a.txt
cp $WORK/local-a.txt $WORK/out/a.txt
cd out

# 第一轮：冲突 → exit=2，报告打印可复制的 accept 命令
xinit-code update
stdout 'merge-conflict\s+a\.txt'
stdout 'xinit update --accept \x27a\.txt\x27'
stdout 'exit=2'

# 用户手工解决（结果与模板不同）后直接重跑 = §10.3 的死循环：仍被拒
cp $WORK/resolved-a.txt a.txt
xinit-code update
stdout '未解决的冲突'
stdout 'xinit update --accept \x27a\.txt\x27'
stdout 'exit=2'

# --accept：把解决结果声明为 base → 收敛（base 推进到模板版、磁盘不动）
xinit-code update --accept a.txt
stdout 'exit=0'
! exists .xinit/conflicts/a.txt
cmp .xinit/base/a.txt $WORK/new-a.txt
cmp a.txt $WORK/resolved-a.txt

# 幂等：再跑全 Noop（行 3：模板与 base 一致、本地改动保留）
xinit-code update
stdout '汇总: 写入 0、删除 0、chmod 0、冲突 0'
stdout 'exit=0'

# C1 回归：accept 声明过期——冲突挂起期间模板又前进，重写后 base′ 仍判冲突
# → 还原为「重写前」基线（Metas+Bytes 同步）、不写盘、仍 exit=2。
cp $WORK/b2.txt $WORK/tpl/b.txt
cp $WORK/b-local.txt b.txt
xinit-code update
stdout 'exit=2'

cp $WORK/b3.txt $WORK/tpl/b.txt
xinit-code update --accept b.txt
stdout 'exit=2'
! stderr '写入自检失败'
cmp .xinit/base/b.txt $WORK/b1.txt
cmp b.txt $WORK/b-local.txt

# 过期声明之后，用新的 conflicts/b.txt（= b3）重新 accept → 收敛
xinit-code update --accept b.txt
stdout 'exit=0'
! exists .xinit/conflicts/b.txt
cmp .xinit/base/b.txt $WORK/b3.txt
cmp b.txt $WORK/b-local.txt

# 拒绝项 A：conflicts/ 里没有该条目
xinit-code update --accept nope.txt
stderr '不存在或不可读'
stdout 'exit=1'

# 拒绝项 E：路径穿越——--accept 只针对 conflicts/ 下的规范相对路径
xinit-code update --accept ../evil.txt
stderr '规范相对路径'
stdout 'exit=1'

# 拒绝项 B：与 --dry-run 组合
xinit-code update --dry-run --accept a.txt
stderr '不能组合'
stdout 'exit=1'

# 拒绝项 C：路径在 prune.txt 里
cp $WORK/prune.txt .xinit/prune.txt
xinit-code update --accept a.txt
stderr '已在 \.xinit/prune\.txt 中'
stdout 'exit=1'

# 拒绝项 D：ConflictKind（ours 是符号链接）——accept 改变不了类型
rm .xinit/prune.txt
rm a.txt
exec ln -s nowhere a.txt
cp $WORK/new2-a.txt $WORK/tpl/a.txt
xinit-code update
stdout 'exit=2'
xinit-code update --accept a.txt
stderr 'ConflictKind'
stdout 'exit=1'

cd ..
# ════ C-1（M9）：BothAdded base✗ 的 --accept 收敛 ════
# 模板新增 u.txt、本地已有同名不同内容 ⇒ BothAdded；accept? 打印的命令必须
# 真实可用（修复前 rc=1「内部错误：…保持旧 base 但 files 里没有它」）。
# 两个子项目都在模板拿到 u.txt 之前 init（out2/out3 的 base✗ 前提）。
xinit init --template $WORK/tpl --yes out2
xinit init --template $WORK/tpl --yes out3
cp $WORK/u-theirs.txt $WORK/tpl/u.txt
cp $WORK/u-local.txt $WORK/out2/u.txt
cd out2
xinit-code update
stdout 'conflict-both-added\s+u\.txt'
stdout 'xinit update --accept \x27u\.txt\x27'
stdout 'exit=2'
# accept：本地内容保留、base 记模板版、路径自此受管（= 纯重跑收敛的同一末态）
xinit-code update --accept u.txt
stdout 'exit=0'
! exists .xinit/conflicts/u.txt
cmp u.txt $WORK/u-local.txt
cmp .xinit/base/u.txt $WORK/u-theirs.txt
grep 'u\.txt' .xinit/state.json
# 收敛复核：下一轮零冲突、磁盘不动
xinit-code update
stdout 'exit=0'
cmp u.txt $WORK/u-local.txt
cd ..
# ════ C-1 变体（M9）：ours 已手工改到与 theirs 一致后 accept ════
cp $WORK/u-local.txt $WORK/out3/u.txt
cd out3
xinit-code update
stdout 'conflict-both-added\s+u\.txt'
stdout 'exit=2'
cp $WORK/u-theirs.txt u.txt
xinit-code update --accept u.txt
stdout 'exit=0'
cmp u.txt $WORK/u-theirs.txt
cmp .xinit/base/u.txt $WORK/u-theirs.txt
cd ..

-- tpl/xinit.yml --
manifest_version: 1
-- tpl/a.txt --
a1
-- tpl/b.txt --
b1
-- b1.txt --
b1
-- b2.txt --
b2
-- b3.txt --
b3
-- b-local.txt --
b-local
-- new-a.txt --
a2
-- new2-a.txt --
a3
-- local-a.txt --
local
-- resolved-a.txt --
a2 plus local tweak
-- prune.txt --
a.txt
-- u-theirs.txt --
u-theirs
-- u-local.txt --
u-local
