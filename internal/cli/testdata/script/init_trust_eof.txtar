# init 侧信任门的会话化入口（评审 F2；§19.3/§19.2.3）：vars 采集用**半行**
# stdin（`MyApp` 无换行 ⇒ askLine 收到「内容 + EOF」：半行内容有效、会话随即
# EOF 锁存）满足唯一的必填变量后，第 4 步信任门不得再打一行无人回答的
# 「信任并执行？[y/N] 」——披露（notice + 指引）照旧，仍退 4、仍零写。
# 牙齿：init 侧调用点若单独回退成 hooks.Confirm（M7 T3 前的形态），本脚本
# 立刻转红（`! stdout '信任并执行？'`）——update 侧的对偶锚见 trust_eof.txtar。
# 半行文件由 printf 现造：txtar 正文恒以 \n 结束，放不下无换行的半行。

env HOME=$WORK/home
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
mkdir tpl
cp $WORK/tpl.yml tpl/xinit.yml
cp $WORK/a1.txt tpl/a.txt
exec git init -q tpl
cd tpl
exec git add .
exec git commit -qm v1
exec git tag v0.1.0
cd ..

exec sh -c 'printf "%s" "MyApp" > "$WORK/half.txt"'
stdin $WORK/half.txt
xinit-code init --template $WORK/tpl --interactive out
# vars 提示逐字（V2：无默认值的必填项）+ 半行内容被采纳（非空 ⇒ 不触发 V6 中止）
stdout '产品显示名（必填）: '
# 信任门确实走到了：披露照旧（§10.5），只省提问行
stdout '模板钩子 post_init 需要确认'
stdout '这是上游模板里的任意 shell 命令：确认前请检查上面每一行。'
stdout '退出码 4 = 需要信任确认，本轮未做任何修改。'
! stdout '信任并执行？'
stdout 'exit=4'
# 零写：checkDestUsable 建的 out/ 之外一无所有——无渲染产物、无 .xinit/、
# 无钩子副作用（第 4 步先于第 5–10 步的一切写入）
exists out
exec sh -c 'test -z "$(ls -A out)"'
! exists out/.xinit
! exists out/a.txt
! exists out/hook_out.txt

-- tpl.yml --
manifest_version: 1
vars:
  - name: product
    prompt: 产品显示名
    required: true
hooks:
  post_init: |
    echo ok > hook_out.txt
-- a1.txt --
hello
