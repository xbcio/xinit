# §19.2.1 行为矩阵的脚本级锚：fd0 = /dev/null 是字符设备但**不是终端**。
# 修正前会多打一行 `信任并执行？[y/N] `（随后读到 EOF 仍退 4）；
# 修正后只报告、不提问。行为面唯一变化点，其余（退 4、零写）逐字节不变。
# 护栏同 interactive_tty.txtar：只有 darwin/linux 装了 termios 判据（其余
# unix 走 legacy ModeCharDevice 判据 ⇒ /dev/null 被判成可交互，脚本假失败）。
[!linux] [!darwin] skip

env HOME=$WORK/home
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
mkdir tpl
cp $WORK/base.yml tpl/xinit.yml
cp $WORK/a1.txt tpl/a.txt
exec git init -q tpl
cd tpl
exec git add .
exec git commit -qm v1
exec git tag v0.1.0
cd ..
xinit init --template $WORK/tpl --yes out
cd out
cp .xinit/state.json $WORK/state0.json
cp $WORK/hooks-a.yml $WORK/tpl/xinit.yml
cp $WORK/a2.txt $WORK/tpl/a.txt
cd ../tpl
exec git add .
exec git commit -qm v2
exec git tag v0.2.0
cd ../out

# 重定向由 sh 完成：注册命令以真二进制装进 bindir 并前置进 PATH，故 sh 找得到
# xinit-code（本仓已有 `exec sh -c '…'` 先例）。
exec sh -c 'xinit-code update --revision v0.2.0 < /dev/null'
stdout '模板钩子 post_update 需要确认'
stdout 'echo A > out_a.txt'
stdout 'exit=4'
! stdout '信任并执行？'
! exists out_a.txt
! exists .xinit/backup
cmp .xinit/state.json $WORK/state0.json

-- base.yml --
manifest_version: 1
-- a1.txt --
hello
-- a2.txt --
hello2
-- hooks-a.yml --
manifest_version: 1
hooks:
  post_update: |
    echo A > out_a.txt
