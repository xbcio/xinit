# 钩子失败（dir 源）：退出码 3；本轮写入与 state 已完成并保留（§10.2 :845）；
# 修好后重跑即收敛。

xinit init --template $WORK/tpl --yes out
cp $WORK/new-a.txt $WORK/tpl/a.txt
cp $WORK/hooks-fail.yml $WORK/tpl/xinit.yml
cd out
cp .xinit/state.json $WORK/state-before.json

xinit-code update --yes
stdout 'post_update 失败（钩子退出码 9；xinit 退出码 3）'
# 失败块确实重打了失败命令（评审 Nit-1：原断言可被信任通知全文满足）
stdout '失败命令（sh -c，工作目录 = 项目根）：'
stdout 'echo partial > partial.txt'
stdout 'exit=3'

# 文件已落盘、state 确实被改写（与更新前的字节快照不同）、钩子失败前的产物保留
cmp a.txt $WORK/new-a.txt
cmp partial.txt $WORK/partial.txt
! cmp .xinit/state.json $WORK/state-before.json

# 修好钩子后重跑：钩子内容已变 → 再次确认（由 --yes 覆盖）、执行成功、退出 0
cp $WORK/hooks-ok.yml $WORK/tpl/xinit.yml
xinit-code update --yes
stdout 'exit=0'

-- tpl/xinit.yml --
manifest_version: 1
-- tpl/a.txt --
a1
-- new-a.txt --
a2
-- hooks-fail.yml --
manifest_version: 1
hooks:
  post_update: |
    echo partial > partial.txt
    exit 9
-- hooks-ok.yml --
manifest_version: 1
hooks:
  post_update: |
    echo partial > partial.txt
-- partial.txt --
partial
