# init --revision（重开 v1.0.2 D2）：用 tag 直接钉版本，随后 update 默认模式即可用。
#   ① init --revision v1.0.0：派生树是 v1.0.0 的内容（不是 HEAD 的），state.revision 记 tag 原文；
#   ② 本批关键点：out 建 git 仓后**不带 --revision** 跑 update → 退 0 且升到 v1.1.0
#      （记 tag ⇒ 可 semver 比较，无需先做显式对齐；对照记 "HEAD" 时必须先 update --revision）；
#      默认取最高 tag（v1.1.0），不是未打 tag 的 HEAD（unreleased）——判别点；
#   ③ 无效 ref：退 1、stderr 点名「模板中不存在版本」、dest 无任何产物（checkDestUsable
#      先建出空目录，故 out2 存在但为空）；
#   ④ 不带 --revision 的 init 记 "HEAD"，随后不带旗标 update 退 1：选版报错须说明对齐目标
#      必须是 vX.Y.Z 形式的 tag（锁 version.go 的报错文案；此前无任何测试锁这句）。
# 模板是 $WORK 下的本地 git 工作仓（isGitRepo ⇒ 直用、不走镜像 ⇒ 无需缓存接线）。
# 所有仓路径用 $WORK 绝对路径：脚本中途会 cd 进 out，相对路径会落到错误的 cwd。

env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
env GIT_CEILING_DIRECTORIES=$WORK

# 旗标已注册（help 里可见）
xinit init --help
stdout '--revision string'

# 模板：v1.0.0 → v1.1.0 → 再来一次未打 tag 的提交（HEAD = unreleased）
exec git -c init.defaultBranch=main init -q $WORK/w
cp $WORK/xinit.yml $WORK/w/xinit.yml
cp $WORK/v1.txt $WORK/w/a.txt
exec git -C $WORK/w add -A
exec git -C $WORK/w commit -qm v1.0
exec git -C $WORK/w tag v1.0.0
cp $WORK/v11.txt $WORK/w/a.txt
exec git -C $WORK/w commit -qam v1.1
exec git -C $WORK/w tag v1.1.0
cp $WORK/unreleased.txt $WORK/w/a.txt
exec git -C $WORK/w commit -qam unreleased

# ── ① 钉 v1.0.0：内容是 v1 的，state 记 tag 原文 ──
xinit init --template $WORK/w --revision v1.0.0 --yes out
stdout '已生成 1 个文件'
cmp out/a.txt $WORK/v1.txt
grep '"revision": "v1\.0\.0"' out/.xinit/state.json
grep '"kind": "git"' out/.xinit/state.json
! grep 'HEAD' out/.xinit/state.json

# ── ② 建 git 仓后不带 --revision 跑 update：直接升到最高 tag v1.1.0 ──
exec git init -q $WORK/out
cd $WORK/out
xinit-code update
stdout '版本: v1\.0\.0 → v1\.1\.0'
stdout '汇总: 写入 1、删除 0、chmod 0、冲突 0'
stdout 'exit=0'
! stderr '不是 vX\.Y\.Z 格式'
cmp a.txt $WORK/v11.txt
grep '"revision": "v1\.1\.0"' .xinit/state.json
! grep 'unreleased' a.txt
cd $WORK

# ── ③ 无效 ref：任何写入之前失败，dest 无产物 ──
! xinit init --template $WORK/w --revision no-such-ref --yes out2
stderr '模板中不存在版本 "no-such-ref"'
exists out2
exec sh -c 'test -z "$(ls -A out2)"'
! exists out2/.xinit
! exists out2/a.txt

# ── ④ 不带 --revision 的 init 记 "HEAD"：随后不带旗标 update 退 1，且报错须说明对齐目标
#    必须是 vX.Y.Z 形式的 tag（锁 version.go 的选版报错文案；对齐到分支名之后默认模式仍不可用）──
xinit init --template $WORK/w --yes out3
grep '"revision": "HEAD"' out3/.xinit/state.json
exec git init -q $WORK/out3
cd $WORK/out3
xinit-code update
stdout 'exit=1'
stderr '不是 vX\.Y\.Z 格式'
stderr '<vX\.Y\.Z 形式的 tag>'
stderr '对齐到该 tag 后，默认模式即可继续工作'
cd $WORK

-- xinit.yml --
manifest_version: 1
-- v1.txt --
v1
-- v11.txt --
v11
-- unreleased.txt --
unreleased
