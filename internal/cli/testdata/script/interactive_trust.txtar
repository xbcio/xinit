# --interactive 驱动信任门（§19.2.2、§19.2.3；验收 #5 的「共享 reader」脚本面）：
# testscript 的 stdin 恒为管道 ⇒ 修正后的判据下永远进不了交互分支，此前
# 「真的回答了 y」这条路径在 e2e 与单测中都零覆盖 —— 本脚本即该分支的锚。
# 模板与 hooks_trust.txtar 同形：git 源、v0.1.0 → v0.2.0 新增 post_update。

env HOME=$WORK/home
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
mkdir tpl
cp $WORK/base.yml tpl/xinit.yml
cp $WORK/a1.txt tpl/a.txt
exec git init -q tpl
cd tpl
exec git add .
exec git commit -qm v1
exec git tag v0.1.0
cd ..
xinit init --template $WORK/tpl --yes out
cd out
cp .xinit/state.json $WORK/state0.json
cp $WORK/hooks-a.yml $WORK/tpl/xinit.yml
cp $WORK/a2.txt $WORK/tpl/a.txt
cd ../tpl
exec git add .
exec git commit -qm v2
exec git tag v0.2.0
cd ../out

# ① 管道 + --interactive：信任门被驱动（此前 e2e 零覆盖的分支），回答 y 后同轮继续
stdin $WORK/yes.txt
xinit-code update --revision v0.2.0 --interactive
stdout '模板钩子 post_update 需要确认'
stdout '信任并执行？\[y/N\]'
stdout 'exit=0'
grep '"sha256:[0-9a-f]{64}": "v0.2.0"' .xinit/state.json
cmp a.txt $WORK/a2.txt

# ② 同一 stdin 但不带 --interactive：不读、不提示，退出码与不预填相同
# 夹具复位（T1 实现期补：任务书原文缺此一条）：① 是成功轮，已写出 out_a.txt
# 并建了 .xinit/backup/ —— 清掉这两样，后面的 `! exists …` 才成为「本轮零写」
# 的判别器（§10.2 第 6 步先于第 7 步备份）。
rm -f out_a.txt
rm .xinit/backup
cp .xinit/state.json $WORK/state1.json
cp $WORK/hooks-b.yml $WORK/tpl/xinit.yml
cd ../tpl
exec git add .
exec git commit -qm v3
exec git tag v0.3.0
cd ../out
stdin $WORK/yes.txt
xinit-code update --revision v0.3.0
stdout 'exit=4'
! stdout '信任并执行？'
! exists out_a.txt
! exists out_b.txt
! exists .xinit/backup
cmp .xinit/state.json $WORK/state1.json

# ③ --interactive + 回答 n → 仍退 4、零写
stdin $WORK/no.txt
xinit-code update --revision v0.3.0 --interactive
stdout '信任并执行？\[y/N\]'
stdout 'exit=4'
! exists out_b.txt
! exists .xinit/backup
cmp .xinit/state.json $WORK/state1.json

# ④ --interactive + EOF（空 stdin 文件）→ 仍退 4、零写
stdin $WORK/empty.txt
xinit-code update --revision v0.3.0 --interactive
stdout 'exit=4'
! exists .xinit/backup
cmp .xinit/state.json $WORK/state1.json

-- base.yml --
manifest_version: 1
-- a1.txt --
hello
-- a2.txt --
hello2
-- hooks-a.yml --
manifest_version: 1
hooks:
  post_update: |
    echo A > out_a.txt
-- hooks-b.yml --
manifest_version: 1
hooks:
  post_update: |
    echo B > out_b.txt
-- yes.txt --
y
-- no.txt --
n
-- empty.txt --
