# 信任门的会话化入口（M3/M4，2026-10-11 M7；§19.2.3）：4b 冲突问答先把 stdin
# 耗尽（空 stdin ⇒ 第一问即 EOF、C3 早退），随后第 12 步的信任门**不得**再打
# 一行无人回答的「信任并执行？[y/N] 」——披露（notice + 指引）照旧，只有提问
# 行被省掉；退出码与零写语义逐字节不变（仍 4、仍零写）。
# 模板与 interactive_trust.txtar 同形（git 源、v0.1.0 → v0.2.0 新增 post_update），
# 另加本地改 a.txt 以制造**可问**的 Merge 冲突（§19.4.1 闭集：键存在 ∧ 判冲突）。

env HOME=$WORK/home
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
mkdir tpl
cp $WORK/base.yml tpl/xinit.yml
cp $WORK/a1.txt tpl/a.txt
exec git init -q tpl
cd tpl
exec git add .
exec git commit -qm v1
exec git tag v0.1.0
cd ..
xinit init --template $WORK/tpl --yes out
cd out
cp .xinit/state.json $WORK/state0.json
# 本地改 a.txt（v0.2.0 也改它 ⇒ Merge 判冲突、可问）
cp $WORK/local-a.txt a.txt
cp $WORK/hooks-a.yml $WORK/tpl/xinit.yml
cp $WORK/a2.txt $WORK/tpl/a.txt
cd ../tpl
exec git add .
exec git commit -qm v2
exec git tag v0.2.0
cd ../out

# 空 stdin：4b 提问行照打、读到 EOF 打 C3 行并锁存；信任门只剩披露、无提问行
stdin $WORK/empty.txt
xinit-code update --revision v0.2.0 --interactive
stdout '交互式冲突解决（1 条，§19.4）'
stdout 'a\.txt（merge-conflict）改用模板版？\[y/N\]'
stdout '输入已结束（EOF）：其余 1 条冲突按「保留本地」处理（§19.4）。'
# 信任门确实走到了：披露照旧（§10.5），只省提问行
stdout '模板钩子 post_update 需要确认'
stdout '这是上游模板里的任意 shell 命令：确认前请检查上面每一行。'
! stdout '信任并执行？'
stdout 'exit=4'
# 零写：无备份、无钩子副作用、无 conflicts/ 条目、state.json 逐字节不变
! exists .xinit/backup
! exists out_a.txt
! exists .xinit/conflicts/a.txt
cmp .xinit/state.json $WORK/state0.json
cmp a.txt $WORK/local-a.txt

-- base.yml --
manifest_version: 1
-- a1.txt --
hello
-- a2.txt --
hello2
-- local-a.txt --
local
-- hooks-a.yml --
manifest_version: 1
hooks:
  post_update: |
    echo A > out_a.txt
-- empty.txt --
