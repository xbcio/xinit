# O-1（M9）：相对路径模板源 → state 记绝对路径 → 项目内 update 可用。
# 修复前：update 从项目内按 cwd 解析「tpl」失败 → 落入「本地不存在→git URL」
# 分支 → `克隆模板仓库 tpl` rc=1。

env GIT_CEILING_DIRECTORIES=$WORK
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
env HOME=$WORK/home
env XDG_CACHE_HOME=$WORK/home/xdg
mkdir $WORK/home

xinit init --template tpl --yes out
grep 'source.*/tpl' out/.xinit/state.json
cd out
xinit-code update
stdout 'exit=0'
cd ..

# ── git 仓目录源（相对路径）：判据宽于 IsDirSource，同样记绝对（M9 O-1） ──
exec git -c init.defaultBranch=main init -q tplgit
mkdir tplgit
cp tpl/xinit.yml tplgit/xinit.yml
cp tpl/a.txt tplgit/a.txt
exec git -C tplgit add -A
exec git -C tplgit commit -qm v1
exec git -C tplgit tag v1.0.0
xinit init --template tplgit --yes out2
grep 'source.*/tplgit' out2/.xinit/state.json
cd out2
xinit-code update --revision v1.0.0
stdout 'exit=0'
cd ..

-- tpl/xinit.yml --
manifest_version: 1
-- tpl/a.txt --
hello
