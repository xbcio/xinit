[windows] skip '缓存接线为 darwin/Linux 形态；Windows 变体待真机'
# backflow 警告不导出面（§20.7 边界总表 / §20.5 域与扫描 / §20.4 守卫 3 未跟踪警告）：
# 域外 / prune / 来源消失（update keep-warned 后记录 commit 里已无）/ binary / generated /
# render / symlink / 改名 / 新增路径多命中 → 全部 exit=0 + 文案断言（文案基准表第 6、7、9、10、12 行）；
# 新增行含派生 token → 扫描行格式；未跟踪只警告、拒绝文案零出现。

env GIT_CEILING_DIRECTORIES=$WORK
env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
env HOME=$WORK/home
env XDG_CACHE_HOME=$WORK/home/xdg
mkdir $WORK/home

# ── 模板仓（git 源，v1.0.0）：upstream / generated / render 规则齐备 ──
exec git -c init.defaultBranch=main init -q $WORK/tpl
mkdir $WORK/tpl/keep $WORK/tpl/out $WORK/tpl/gen $WORK/tpl/bin $WORK/tpl/r $WORK/tpl/prune $WORK/tpl/gone
cp $WORK/xinit.yml $WORK/tpl/xinit.yml
cp $WORK/k1.txt $WORK/tpl/keep/k.txt
cp $WORK/o1.txt $WORK/tpl/out/o.txt
cp $WORK/g1.txt $WORK/tpl/gen/g.txt
exec sh -c 'printf "b\000in1\n" > $WORK/tpl/bin/b.bin'
cp $WORK/r1.txt $WORK/tpl/r/r.txt
cp $WORK/p1.txt $WORK/tpl/prune/p.txt
cp $WORK/gone1.txt $WORK/tpl/gone/g.txt
cp $WORK/ren1.txt $WORK/tpl/keep/ren.txt
exec git -C $WORK/tpl add -A
exec git -C $WORK/tpl commit -qm v1
exec git -C $WORK/tpl tag v1.0.0

# ── init 派生 → root 提交 → 声明 prune ──
mkdir $WORK/proj
cd $WORK/proj
exec git -c init.defaultBranch=main init -q
xinit init --template $WORK/tpl --yes .
exec git add -A
exec git commit -qm c0
cp $WORK/prune.txt .xinit/prune.txt

# ── 本地改过 gone/g.txt（未提交）→ 模板删它 → update 行 9 keep-warned ──
cp $WORK/gone2.txt gone/g.txt
exec git -C $WORK/tpl rm -q gone/g.txt
exec git -C $WORK/tpl commit -qm 'drop gone'
exec git -C $WORK/tpl tag v1.1.0
xinit-code update --revision v1.1.0
stdout 'exit=0'
stdout 'keep-warned\s+gone/g\.txt'

# ── 派生侧一批改动（一次提交 + trailer）：覆盖全部警告出口 ──
cp $WORK/k2.txt keep/k.txt
cp $WORK/o2.txt out/o.txt
cp $WORK/g2.txt gen/g.txt
exec sh -c 'printf "b\000in2\n" > bin/b.bin'
cp $WORK/r2.txt r/r.txt
cp $WORK/p2.txt prune/p.txt
exec git mv keep/ren.txt keep/ren2.txt
cp $WORK/new.txt keep/new.txt
cp $WORK/ambig.txt keep/myapp2.txt
symlink keep/link -> target
exec git add -A
exec git commit -qm 'feat: warn faces' -m 'Template-Upstream: yes'

# ── 未跟踪文件：只警告、不挡导出 ──
cp $WORK/untracked.txt untracked.txt

# ── 导出：警告面全部 exit=0 ──
xinit-code backflow HEAD
stdout 'exit=0'
stdout 'backflow-ok keep/k\.txt'
stdout 'backflow-ok keep/new\.txt'
# 域外（§20.5）
stdout 'backflow-excluded out/o\.txt: 不属于共享面（upstream\.paths）'
# prune（§20.5）：判据 = .xinit/prune.txt
stdout 'backflow-excluded prune/p\.txt: 该路径已脱离管理，无法确定模板路径'
# 来源消失（§20.5 句 2 半面；守卫 7 成因② 半面见下方 M9 扩展块）
stdout 'backflow-excluded gone/g\.txt: 该路径的模板来源已不存在'
stdout '`--map` 显式给出模板路径'
# binary（§20.7）
stdout 'backflow-excluded bin/b\.bin: .*二进制'
# generated（§20.7）
stdout 'backflow-excluded gen/g\.txt: .*generated'
# render 模式（§20.7）
stdout 'backflow-excluded r/r\.txt: .*render 模式'
# symlink（§20.7）
stdout 'backflow-excluded keep/link: .*符号链接'
# 改名（§20.7）
stdout 'backflow-excluded keep/ren2\.txt: .*重命名'
# 新增路径多命中（§20.7 规则 3）：打印候选 + --map 出口
stdout 'backflow-excluded keep/myapp2\.txt: .*--map'
stdout '多命中（候选：'
# 扫描命中（§20.5 判据、§20.10 行 12）：file:line: token — 内容 + 自陈
stdout 'backflow-warn keep/new\.txt:1: myapp — hello myapp'
stdout '未经硬闸门'
# 未跟踪只警告（§20.4 守卫 3）
stdout 'backflow-warn 未跟踪文件'
stdout 'untracked\.txt'
! stdout '拒绝回流'
! stdout '请先 commit'

# ── 新增文件的 --map 出口（§20.7 规则 4：闸门 = 目标不得已存在于模板树）──
xinit-code backflow HEAD --map keep/myapp2.txt=keep/brand-new.txt
stdout 'exit=0'
stdout 'backflow-ok keep/myapp2\.txt -> keep/brand-new\.txt'
# 闸门：--map 到模板已存在的路径 → 拒绝（证明新增映射确实过 ApplyMap 闸门，
# 而非直接采用 Src；受管路径的 --map 救援方向相反，不在此函数）
xinit-code backflow HEAD --map keep/myapp2.txt=keep/k.txt
stdout 'exit=1'
stderr '该路径在模板中已存在，不是新增文件'

# ── 观察-3（M9）：`--map` 救援命中失败点单独措辞，非循环指引 ──
xinit-code backflow --map keep/k.txt=keep/nope.txt HEAD
stdout 'backflow-excluded keep/k\.txt: `--map` 给出的模板路径 "keep/nope\.txt" 不在记录 commit 的模板树中'
stdout 'backflow-excluded gone/g\.txt: 该路径的模板来源已不存在'
stdout 'exit=0'

# ── M9 扩展：守卫 7 成因②（Dst 已脱离模板渲染集）专用文案；--map 不改判定 ──
xinit-code backflow --map gone/g.txt=keep/k.txt HEAD
stdout 'exit=0'
stdout 'backflow-excluded gone/g\.txt: 该路径已脱离模板'

# ── 扫描 ≤40 截断（§20.5 / §20.10 行 12）：命中 >40 → 逐条只打 40 + 「≥40」──
exec sh -c 'i=0; while [ $i -lt 45 ]; do echo "line myapp"; i=$((i+1)); done > keep/many.txt'
exec git add -A
exec git commit -qm 'feat: many hits' -m 'Template-Upstream: yes'
xinit-code backflow HEAD
stdout 'exit=0'
stdout 'backflow-ok keep/many\.txt'
stdout '≥40'
# 截断而非绕开上限：第 41+ 条不得出现（45 行命中，只列前 40 条）
! stdout 'keep/many\.txt:4[1-9]:'

# ── vacuous 的两成因之「全空渲染」（§20.5 ②③，评审 M-2）：规则在、渲染为空串 ──
# 剔除提示（②）必须与 vacuous 行（③）同时出现——而非被 vacuous 分支吞掉。
exec git -c init.defaultBranch=main init -q $WORK/tplv
mkdir $WORK/tplv/keep
cp $WORK/tplv-xinit.yml $WORK/tplv/xinit.yml
cp $WORK/k1.txt $WORK/tplv/keep/k.txt
exec git -C $WORK/tplv add -A
exec git -C $WORK/tplv commit -qm v1
exec git -C $WORK/tplv tag v1.0.0

mkdir $WORK/projv
cd $WORK/projv
exec git -c init.defaultBranch=main init -q
xinit init --template $WORK/tplv --yes .
exec git add -A
exec git commit -qm c0
cp $WORK/k2.txt keep/k.txt
exec git add -A
exec git commit -qm 'feat: k' -m 'Template-Upstream: yes'
xinit-code backflow HEAD
stdout 'exit=0'
stdout 'backflow-ok keep/k\.txt'
# ② 剔除提示：逐条点名规则
stdout '未产出扫描 token'
stdout 'substitute\[0\]\.to'
# ③ 空集 vacuous 行（成因＝全空渲染）
stdout '渲染后为空集（vacuous）'
stdout '未经硬闸门'

-- xinit.yml --
manifest_version: 1
vars:
  - name: app
    default: "myapp"
substitute:
  - from: "mytmpl"
    to: "{{ .app }}"
    paths: ["**"]
render:
  - paths: ["r/**"]
generated:
  paths: ["gen/**"]
upstream:
  # 域判定先于边界分类（域外是硬闸门）：要让 binary/generated/render/symlink
  # 等边界出口在报告里现身，夹具须把它们纳入共享面；out/** 取反留作域外面。
  paths: ["**", "!out/**"]
-- tplv-xinit.yml --
manifest_version: 1
vars:
  - name: app
    default: "myapp"
  - name: opt
    default: ""
substitute:
  - from: "mytmpl"
    to: "{{ .opt }}"
    paths: ["**"]
upstream:
  paths: ["keep/**"]
-- prune.txt --
prune/**
-- k1.txt --
k1
-- k2.txt --
k2
-- o1.txt --
o1
-- o2.txt --
o2
-- g1.txt --
g1
-- g2.txt --
g2
-- r1.txt --
value: {{ .app }}
-- r2.txt --
value: changed
-- p1.txt --
p1
-- p2.txt --
p2
-- gone1.txt --
gone1
-- gone2.txt --
gone2
-- ren1.txt --
ren1
-- new.txt --
hello myapp
-- ambig.txt --
ambiguous
-- untracked.txt --
u1
