# 快照恢复 · dir 源全命中（§21.10「dir 恢复」/ 判据 2、18）：
# init 写快照 → 删整树 .xinit/base → update 由快照全命中恢复（不依赖模板源重
# 渲染）：恢复行逐字 + 退 0 + stderr 零输出 + 逐文件字节对照 + 零 conflicts。
# 工作树须干净（git 仓 + 提交生成物）：脏工作树会让 update 打「未提交改动」
# 警告，挂 ! stderr .。
# 说明：xinit.yml 是隐式排除项（不算受管路径）——本夹具受管 = a.txt + sub/run.sh。

env GIT_AUTHOR_NAME=x GIT_AUTHOR_EMAIL=x@x GIT_COMMITTER_NAME=x GIT_COMMITTER_EMAIL=x@x
env GIT_CEILING_DIRECTORIES=$WORK

xinit init --template $WORK/tpl --yes out
exec git init -q $WORK/out
cd $WORK/out
# 预写排除（与 EnsureGitExcluded 同判据：整行 `.xinit/`）后提交生成物 → 工作树干净
exec sh -c 'printf ".xinit/\n" >> .git/info/exclude'
exec git add -A
exec git commit -qm gen

# 删整树 base：state.Files 两条记录全部 need
rm -rf .xinit/base

xinit-code update
stdout '^base 恢复（来自渲染快照，不依赖模板源，§5\.2、§21）：2 条$'
stdout 'exit=0'
! stderr .

cmp .xinit/base/a.txt $WORK/tpl/a.txt
cmp .xinit/base/sub/run.sh $WORK/tpl/sub/run.sh
! exists .xinit/conflicts

-- tpl/xinit.yml --
manifest_version: 1
-- tpl/a.txt --
one
-- tpl/sub/run.sh --
#!/bin/sh
echo hi
